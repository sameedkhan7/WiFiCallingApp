<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#121212"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings &amp; Profile"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <!-- Card 1: Device Profile -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEVICE PROFILE"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#34A853"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/tvSettingsDeviceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vivo Y51L"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/tvSettingsExtension"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Extension 101 (Hardware Bound)"
                android:textSize="14sp"
                android:textColor="#4285F4"
                android:layout_marginTop="2dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#2C2C2C"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvSettingsNetwork"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Network: Wi-Fi • Online"
                android:textSize="13sp"
                android:textColor="#AAAAAA" />

            <TextView
                android:id="@+id/tvSettingsEncryption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Security: AES-256 Military End-to-End"
                android:textSize="13sp"
                android:textColor="#AAAAAA"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Card 2: Background Running & Battery Autostart -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BACKGROUND &amp; BATTERY"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FBBC05"
                android:letterSpacing="0.1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24/7 Call Listener Service"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginTop="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vivo (Funtouch OS) &amp; OnePlus (OxygenOS) require Auto-start and 'High Background Power' permission so the app never sleeps or turns offline when cleared."
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/btnOpenAutostart"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="⚡ Open Phone Autostart Settings"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="#2E3B4E"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <!-- Card 3: App & Updates -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UPDATES &amp; ABOUT"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#34A853"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/tvSettingsVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Version: v1.1.5 (Hybrid P2P + Cloud)"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:layout_marginTop="6dp" />

            <Button
                android:id="@+id/btnCheckUpdates"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="🔄 Check for Updates"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_button_call"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <!-- Close Button -->
        <Button
            android:id="@+id/btnCloseSettings"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Close"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#262626" />

    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#121212"
    android:gravity="center_horizontal"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="INCOMING WI-FI CALL"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#34A853"
        android:letterSpacing="0.15"
        android:layout_marginTop="40dp" />

    <TextView
        android:id="@+id/tvCallerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Caller Device"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginTop="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Encrypted High-Definition Voice"
        android:textSize="14sp"
        android:textColor="#888888"
        android:layout_marginTop="6dp" />

    <!-- Google Dialer Style Large Avatar -->
    <FrameLayout
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:background="@drawable/bg_circle_avatar"
        android:layout_marginTop="60dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="📞"
            android:textSize="50sp" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Answer & Decline Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="40dp">

        <!-- Decline Button -->
        <Button
            android:id="@+id/btnReject"
            android:layout_width="120dp"
            android:layout_height="56dp"
            android:text="DECLINE"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_reject"
            android:layout_marginEnd="24dp" />

        <!-- Answer Button -->
        <Button
            android:id="@+id/btnAnswer"
            android:layout_width="120dp"
            android:layout_height="56dp"
            android:text="ANSWER"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_call" />
    </LinearLayout>

</LinearLayout>
